# ==============================
# 星月小窝 —— 不要上传的文件
# ==============================

# 系统 / 资源管理器缓存
Thumbs.db
Desktop.ini
.DS_Store

# 编辑器 / IDE 个人配置（按需保留 .vscode/launch.json 的话可删掉这两行）
.vscode/
.idea/
*.suo

# 日志与临时文件
*.log
*.tmp
*~

# 本地调试数据（万一导出过 localStorage 配置，千万别提交！）
*.localstorage.json
*config*.json.bak

# ==============================
# 密钥与敏感信息 —— 绝对禁止上传！
# （tools/hooks/ 里的 pre-commit + pre-push 守卫会双重拦截，
#   每个协作者 clone 后执行一次 npm run hooks 才会生效）
# ==============================

# 环境变量文件（.env.example / .env.sample 是模板，允许提交）
.env
.env.*
!.env.example
!.env.sample

# SSH / GPG / 各类私钥（公钥 *.pub 允许提交）
.ssh/
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.key
*.pem
*.ppk
*.p8
*.asc

# 证书 / 密钥库（含密码库文件）
*.p12
*.pfx
*.jks
*.keystore

# 云平台凭据（AWS / Azure / GCP 等）
.aws/
.azure/
.gcloud/
credentials

# 各类凭据 / 令牌文件
.netrc
.npmrc
.pgpass
*.secret
*.token

# 打包产物（以后如果用到构建工具）
node_modules/
dist/
build/

# 本地草稿 / 文案笔记（例如给页面写内容的 txt）
*.txt
# 例外：正式文档的纯文本版要入库（配 md 一起看）
!docs/*.txt

# ==============================
# 建议网页（jiangyiwangye）的本机运行数据 —— 绝对不要上传
#   shujuku-1/   ：SQLite 数据库 + 用户上传的图片 / 虚拟奖品文件
#   config.local.json：本机端口、会话密钥、开发模式等配置
#   preview/     ：本机验收截图
# 子目录里也有一份 jiangyiwangye/.gitignore，这里再兜一层，防止以后误删子目录规则
# ==============================
jiangyiwangye/shujuku-1/
jiangyiwangye/config.local.json
jiangyiwangye/preview/

